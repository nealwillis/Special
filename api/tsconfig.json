{
  "compilerOptions": {
    "outDir": "../.api-build",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "./*.ts",
    "../src/core/**/*.ts",
    "../src/server/**/*.ts"
  ],
  "exclude": [
    "../src/**/__tests__/**",
    "../src/**/__fixtures__/**"
  ]
}
